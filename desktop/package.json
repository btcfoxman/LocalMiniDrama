{
  "name": "overseasdrama-desktop",
  "version": "1.2.20",
  "description": "OverseasDrama desktop client",
  "main": "main.js",
  "author": "OverseasDrama",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/btcfoxman/LocalMiniDrama.git"
  },
  "updateAppKey": "overseas-drama-desktop",
  "updateChannel": "stable",
  "updateEnabled": true,
  "scripts": {
    "prestart": "node scripts/copy-backend.js",
    "start": "electron .",
    "build:front": "cd ../frontweb && npm run build",
    "copy-front": "node scripts/copy-front.js",
    "clean:unpacked": "node scripts/clean-win-unpacked.js",
    "pack": "npm run prepare-backend && npm run build:front && npm run copy-front && npm run clean:unpacked && electron-builder --dir",
    "dist": "npm run prepare-backend && npm run build:front && npm run copy-front && npm run clean:unpacked && electron-builder --win",
    "dist:cn": "node scripts/dist-cn.js",
    "dist:mac": "bash dist-mac.sh",
    "postinstall": "node scripts/copy-backend.js && electron-builder install-app-deps",
    "prepare-backend": "node scripts/copy-backend.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1038.0",
    "@volcengine/openapi": "1.36.1",
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^11.6.0",
    "cors": "^2.8.5",
    "electron-updater": "^6.8.3",
    "express": "^4.21.0",
    "js-yaml": "^4.1.0",
    "jsonrepair": "^3.13.3",
    "jsonwebtoken": "^9.0.3",
    "multer": "^1.4.5-lts.1",
    "sharp": "^0.34.5",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1"
  },
  "build": {
    "appId": "com.overseasdrama.desktop",
    "productName": "出海短剧工厂",
    "artifactName": "OverseasDrama-${version}.${ext}",
    "electronUpdaterCompatibility": ">=2.16",
    "extraMetadata": {
      "updateAppKey": "overseas-drama-desktop",
      "updateChannel": "stable",
      "updateEnabled": true
    },
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "package.json",
      "assets/icons/**/*",
      "backend-app/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**",
      "node_modules/sharp/**"
    ],
    "extraResources": [
      {
        "from": "frontweb-dist",
        "to": "frontweb/dist",
        "filter": ["**/*"]
      },
      {
        "from": "../example_drama",
        "to": "example_drama",
        "filter": ["**/*"]
      },
      {
        "from": "../backend-node/tools/ffmpeg",
        "to": "ffmpeg",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "assets/icons/icon.ico",
      "signAndEditExecutable": false
    },
    "mac": {
      "icon": "assets/icons/icon.icns"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "differentialPackage": true,
      "artifactName": "OverseasDrama-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "OverseasDrama-${version}.${ext}"
    }
  }
}
