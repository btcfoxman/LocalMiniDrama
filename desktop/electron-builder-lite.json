{
  "appId": "com.overseasdrama.desktop",
  "productName": "出海短剧工厂",
  "electronUpdaterCompatibility": ">=2.16",
  "extraMetadata": {
    "updateAppKey": "local-mini-drama-desktop-lite",
    "updateServiceBaseUrl": "",
    "updateChannel": "stable",
    "updateEnabled": true
  },
  "directories": {
    "output": "release"
  },
  "files": [
    "main.js",
    "package.json",
    "assets/icons/**/*",
    "backend-app/**/*",
    "node_modules/**/*"
  ],
  "asarUnpack": [
    "node_modules/better-sqlite3/**",
    "node_modules/sharp/**",
    "backend-app/tools/**"
  ],
  "extraResources": [
    {
      "from": "frontweb-dist",
      "to": "frontweb/dist",
      "filter": ["**/*"]
    },
    {
      "from": "../backend-node/tools/ffmpeg",
      "to": "ffmpeg",
      "filter": ["**/*"]
    }
  ],
  "win": {
    "target": ["nsis", "portable"],
    "icon": "assets/icons/icon.ico",
    "signAndEditExecutable": false,
    "artifactName": "OverseasDrama-Lite-${version}.${ext}"
  },
  "mac": {
    "icon": "assets/icons/icon.icns"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "differentialPackage": true,
    "artifactName": "OverseasDrama-Lite-Setup-${version}.${ext}"
  }
}
